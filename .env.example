# Copy to .env and fill in. .env is gitignored — this repo is public.
# Nothing here belongs in a commit, a group text, or an email.

# Ship-to site number the quote is priced against.
MILWAUKEE_SITE=

# Auth0 bearer token from an authenticated Milwaukee Connect session.
# Short-lived: expect to refresh it. A 401 from the connector means this expired.
MILWAUKEE_TOKEN=

# Human description of what that site covers. Shown on every quote so nobody
# mistakes one branch's position for the whole distributor.
MILWAUKEE_SCOPE="Spanish Fork, UT branch only — not all Industrial Supply sites"
